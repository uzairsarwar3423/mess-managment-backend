# Copy to `.env` for local development (npm run dev / docker compose up).
# PRODUCTION: the same variables live ONLY on the VPS in /opt/mess-backend/.env.production (chmod 600),
# created by hand and never touched by CI. Production values that differ from dev:
#   NODE_ENV=production   TRUST_PROXY_HOPS=1   CLOUDINARY_ROOT_FOLDER=mess-prod   LOG_LEVEL=info
#   QR_SIGNING_SECRET / Supabase / Cloudinary: production project keys, never the dev ones.
# See docs/ENVIRONMENT_CONFIGURATION.md. Never commit a real .env file.

# ---- Server
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
APP_TIMEZONE=Asia/Karachi
# Number of reverse proxies (Caddy/Nginx) in front of Node; 0 for local dev
TRUST_PROXY_HOPS=0
# Comma-separated browser origins (leave empty: native apps only)
CORS_ORIGINS=
# Run cron jobs in this process (true on the single production instance)
ENABLE_JOBS=true

# ---- The single mess in v1 (messes.id from database/seed/0007_seed_default_mess.sql)
# Optional: leave empty. With one mess the backend finds it by itself. Set only if you have several.
DEFAULT_MESS_ID=

# ---- Supabase (service-role key is a SECRET: backend only)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary (API secret is a SECRET: backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRESET_PAYMENTS=mess_payments_signed
CLOUDINARY_PRESET_PROFILES=mess_profiles_signed
CLOUDINARY_ROOT_FOLDER=mess-dev
UPLOAD_MAX_BYTES=2097152

# ---- QR signing (SECRET, >= 32 chars, generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
QR_SIGNING_SECRET=

# ---- Rate limiting (global baseline)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Optional
EXPO_ACCESS_TOKEN=
