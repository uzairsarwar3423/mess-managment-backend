# Copy to `.env` and fill in. Never commit the real .env file.
# On the VPS the same values live in /opt/mess-backend/.env.production (see DEPLOY.md): there NODE_ENV=production, CLOUDINARY_ROOT_FOLDER=mess-prod and TRUST_PROXY_HOPS=2 (1 without Cloudflare).

# ---- Server
NODE_ENV=development
PORT=8080
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
APP_TIMEZONE=Asia/Karachi
# Leave empty (mobile apps need none). For browser testing: http://localhost:8081,http://localhost:8082
CORS_ORIGINS=
# The daily subscription jobs. Keep true (only one server runs).
ENABLE_JOBS=true

# ---- Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# SECRET, backend only
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary (Console > Settings > API Keys; the key needs Admin / full access)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=mess-dev
UPLOAD_MAX_BYTES=2097152

# ---- QR signing: SECRET, at least 32 characters.
# Make one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
QR_SIGNING_SECRET=
