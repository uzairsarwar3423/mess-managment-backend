# /opt/mess-backend/migrate.env  (chmod 600) — OPTIONAL. When present, deploy.sh runs pending
# database migrations before switching the app. Delete/rename it to deploy without migrations.
#
# Supabase > Project Settings > Database > Connection string > "Session pooler" (IPv4-compatible).
# Use the session pooler, NOT the transaction pooler (port 6543): migrations need a real session.
PGHOST=aws-0-REGION.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.YOUR-PROJECT-REF
PGPASSWORD=YOUR-DATABASE-PASSWORD
PGDATABASE=postgres
PGSSLMODE=require
